@page "/"
@page "/signup"
@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Nav
<div id="singup_container">

    <h3>Enter your username here:</h3>
    <input placeholder="Enter User name..." @bind="UserName" />

    <h3>Enter your PhoneNumber here:</h3>
    <input placeholder="Enter User PhoneNumber" @bind="Number" />

    <h3>Enter your Gmail here:</h3> <p>This will act as your password</p>
    <input placeholder="Enter User Gmail" @bind="Gmail" />

    <button @onclick="InsertUser">Singup</button>
    <p>@Status</p>


</div>